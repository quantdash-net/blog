---
import { fmtDate, readingTime } from '../utils';
const { post } = Astro.props;
---
<a class="card" href={`/posts/${post.id}/`}>
  <div class="meta"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time><span>·</span><span>{readingTime(post.body)} 分钟阅读</span></div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="tags">{post.data.tags.map((t: string) => <span class="tag">#{t}</span>)}</div>
  <span class="more">阅读全文 →</span>
</a>

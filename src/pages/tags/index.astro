---
import Base from '../../layouts/Base.astro'; import { sortedPosts } from '../../utils';
const ps = await sortedPosts();
const tags = [...new Set(ps.flatMap(p => p.data.tags))].map(t => [t, ps.filter(p => p.data.tags.includes(t)).length] as const);
---
<Base title="标签"><div class="container page"><h1 class="page-title">标签</h1><div class="tag-cloud">{tags.map(([t, n]) => <a class="tag lg" href={`/tags/${t}/`}>#{t}<sup>{n}</sup></a>)}</div></div></Base>

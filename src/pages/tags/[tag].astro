---
import Base from '../../layouts/Base.astro'; import PostCard from '../../components/PostCard.astro'; import { sortedPosts } from '../../utils';
export async function getStaticPaths() { const ps = await sortedPosts(); return [...new Set(ps.flatMap(p => p.data.tags))].map(tag => ({ params: { tag }, props: { ps: ps.filter(p => p.data.tags.includes(tag)) } })); }
const { tag } = Astro.params; const { ps } = Astro.props;
---
<Base title={`标签：${tag}`}><div class="container page"><a class="back" href="/tags/">← 全部标签</a><h1 class="page-title">#{tag}</h1><p class="muted">{ps.length} 篇文章</p><div class="cards">{ps.map(p => <PostCard post={p} />)}</div></div></Base>

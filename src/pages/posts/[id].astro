---
import Base from '../../layouts/Base.astro'; import CategoryBadge from '../../components/CategoryBadge.astro'; import { render } from 'astro:content';
import { sortedPosts, fmtDate, readingTime } from '../../utils';
export async function getStaticPaths() {
  const ps = await sortedPosts();
  return ps.map((p, i) => ({ params: { id: p.id }, props: { p, newer: ps[i - 1], older: ps[i + 1] } }));
}
const { p, newer, older } = Astro.props;
const { Content, headings } = await render(p);
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const pubDate = p.data.date.toISOString();
const dateModified = pubDate;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const publisher = { '@type': 'Organization', name: 'QuantDash', url: 'https://quantdash.net' };
const ogImage = new URL('/og-default.png', Astro.site).href;
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.data.title,
  description: p.data.description,
  datePublished: pubDate,
  dateModified,
  author: publisher,
  publisher,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'zh-CN',
  image: ogImage,
};
---
<Base title={p.data.title} description={p.data.description} type="article" jsonLd={blogPosting}>
  <div class="container post-wrap">
    <article class="post">
      <header class="post-head">
        <a class="back" href="/">← 全部文章</a>
        <div class="tags"><CategoryBadge name={p.data.category} />{p.data.tags.map(t => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}</div>
        <h1>{p.data.title}</h1>
        <p class="lead">{p.data.description}</p>
        <div class="meta"><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time><span>·</span><span>{readingTime(p.body)} 分钟阅读</span></div>
      </header>
      <div class="prose"><Content /></div>
      <nav class="pager">
        {older ? <a href={`/posts/${older.id}/`}><small>← 上一篇</small><span>{older.data.title}</span></a> : <span></span>}
        {newer ? <a class="next" href={`/posts/${newer.id}/`}><small>下一篇 →</small><span>{newer.data.title}</span></a> : <span></span>}
      </nav>
    </article>
    {toc.length > 0 && <aside class="toc"><div class="toc-inner"><h4>目录</h4>{toc.map(h => <a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}</div></aside>}
  </div>
</Base>

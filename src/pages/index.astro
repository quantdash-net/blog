---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro';
import { sortedPosts } from '../utils'; import { LINKS, CATEGORIES } from '../consts';
const posts = await sortedPosts();
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
---
<Base>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow"><i></i>QuantDash 官方博客</span>
      <h1>用数据，<span class="grad">驱动量化研究</span></h1>
      <p class="lead">QuantDash 金融数据 API 与 Python SDK 的教程与更新：A 股 / 美股 / 港股的 K 线、行情快照、五档盘口与日内分时。</p>
      <div class="cta">
        <a class="btn primary" href={LINKS.docs} target="_blank" rel="noopener">阅读文档</a>
        <a class="btn" href={LINKS.github} target="_blank" rel="noopener">Python SDK →</a>
      </div>
      <div class="chips">{['A 股', 'ETF', '美股', '港股', 'K 线', '实时行情', '五档盘口', '日内分时'].map(c => <span>{c}</span>)}</div>
    </div>
  </section>
  <section class="container section">
    <div class="section-head"><h2>最新文章</h2><a class="back" href="/categories/">全部分类 →</a></div>
    <div class="tabs" role="tablist">
      <button class="tab active" data-f="all">全部 <sup>{posts.length}</sup></button>
      {CATEGORIES.map(c => <button class={`tab tab-${c.color}`} data-f={c.name}>{c.name} <sup>{posts.filter(p => p.data.category === c.name).length}</sup></button>)}
    </div>
    <div class="cards" id="cards">{posts.map(p => <PostCard post={p} />)}</div>
    <div class="empty" id="empty" hidden>这个分类还没有文章，敬请期待。</div>
  </section>
  <script is:inline>
    document.querySelectorAll('.tab').forEach(function(b){b.addEventListener('click',function(){
      document.querySelectorAll('.tab').forEach(function(x){x.classList.toggle('active',x===b)});
      var f=b.dataset.f,n=0;document.querySelectorAll('#cards .card').forEach(function(c){var s=f==='all'||c.dataset.cat===f;c.style.display=s?'':'none';if(s)n++;});
      document.getElementById('empty').hidden=n>0;});});
  </script>
</Base>
